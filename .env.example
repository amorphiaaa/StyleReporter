APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Future database connection. The scaffold does not open a database connection.
DATABASE_URL=postgresql+asyncpg://styler:styler@localhost:5432/stylereporter

# Google Sheets adapter. Keep credentials out of git; live sync is disabled by default.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Form Responses 1
GOOGLE_SHEET_RANGE=
# Optional versioned questionnaire mapping from backend/app/domain/questionnaire_definitions.
GOOGLE_QUESTIONNAIRE_VERSION=
# Set true only when applying a changed mapping to already imported rows.
GOOGLE_REFRESH_EXISTING=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_TIMEOUT_SECONDS=10

# Local client evidence workspace. URLs are registered in manifests; provider
# downloads are intentionally a separate follow-up step.
ASSET_STORAGE_ENABLED=true
ASSET_STORAGE_ROOT=var/assets

# Legacy Agents SDK contract preview. It makes no model calls and does not need a key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AGENT_RUNTIME_ENABLED=false

# Local Codex CLI runtime. Start tools/codex_cli_worker.py on the host after
# running `codex login`; the backend calls that worker instead of the OpenAI API.
CODEX_CLI_ENABLED=true
CODEX_CLI_RUNNER_URL=http://host.docker.internal:8787
CODEX_CLI_RUNNER_TOKEN=
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=600

# Future Canva connector. No OAuth/MCP calls are made by the scaffold.
CANVA_CONNECTOR_URL=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
