APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Future database connection. The scaffold does not open a database connection.
DATABASE_URL=postgresql+asyncpg://styler:styler@localhost:5432/stylereporter

# Google Sheets adapter. Keep credentials out of git; live sync is disabled by default.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Form Responses 1
GOOGLE_SHEET_RANGE=
# Optional versioned questionnaire mapping from backend/app/domain/questionnaire_definitions.
GOOGLE_QUESTIONNAIRE_VERSION=
# Set true only when applying a changed mapping to already imported rows.
GOOGLE_REFRESH_EXISTING=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_TIMEOUT_SECONDS=10

# Local client evidence workspace. Downloads remain opt-in.
ASSET_STORAGE_ENABLED=true
ASSET_STORAGE_ROOT=var/assets
ASSET_DOWNLOAD_ENABLED=false
ASSET_DOWNLOAD_TIMEOUT_SECONDS=30
ASSET_DOWNLOAD_MAX_BYTES=20971520

# Canonical Google Drive client workspace. OAuth is used for a personal Drive;
# the service account remains available for a Shared Drive deployment.
GOOGLE_DRIVE_STORAGE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TIMEOUT_SECONDS=30
GOOGLE_DRIVE_OAUTH_CLIENT_JSON=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
