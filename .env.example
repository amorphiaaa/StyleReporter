APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Future database connection. The scaffold does not open a database connection.
DATABASE_URL=postgresql+asyncpg://styler:styler@localhost:5432/stylereporter

# Future Google Sheets adapter. Never commit credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Form Responses 1

# Agents SDK adapter settings. The current agents_sdk_dry_run path makes no model calls.
OPENAI_API_KEY=
OPENAI_MODEL=

# Future Canva connector. No OAuth/MCP calls are made by the scaffold.
CANVA_CONNECTOR_URL=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
